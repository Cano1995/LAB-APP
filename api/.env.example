# Conexión Oracle a DESA (servidor oradesa). El GATEC viejo en producción usa el alias BDTEB → producción.
# En modo thick: requiere cliente Oracle 12.1 (ver CLAUDE.md de Agente-ia).
DB_USER=BOT
DB_PASSWORD=
DB_CONNECT_STRING=10.213.52.25:1521/BDTEB
# DESA (servidor oradesa). OJO: producción usa el MISMO nombre de servicio BDTEB (10.213.52.70).
# La API verifica el servidor al arrancar y no inicia si no es este:
DB_HOST_ESPERADO=oradesa
ORACLE_CLIENT_LIB_DIR=C:\app\Middleware\Oracle_Home\bin

# Esquema donde viven las tablas propias de la app (auth, etc.).
# Debe ser un esquema PERSISTENTE: en DESA lo creado a mano se borra cada día,
# así que en dev la app lo recrea al arrancar (bootstrap idempotente).
APP_SCHEMA=BOT

# Esquema del núcleo GATEC (usuarios, permisos, catálogos).
GATEC_SCHEMA=GATEC_AGR

# Secreto para firmar los JWT: mínimo 32 caracteres, aleatorio y distinto en cada entorno (la API no arranca con uno corto ni con este ejemplo).
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio

# Orígenes del navegador que pueden llamar a la API, separados por coma. Por defecto solo el front local (http://localhost:3100).
# CORS_ORIGIN=http://localhost:3100
JWT_EXPIRES=8h

# EDICIÓN (Sprint 18). Cada función que graba en las tablas del GATEC está APAGADA por defecto; =1 la enciende, y solo funciona contra DESA
# (con otra base no se enciende salvo ESCRITURA_EN_PRODUCCION=1, una decisión que hoy nadie tomó).
# ESCRITURA_GPI_DIGITACION=1
# ESCRITURA_EN_PRODUCCION=1

# Marca por defecto (se usa mientras no haya nada guardado en Administración → Configuración).
# APP_NOMBRE=Lab App
# APP_NOMBRE_CORTO=Lab App
# APP_EMPRESA=
# APP_LEMA=
# APP_DESCRIPCION=
# APP_PAIS=

PORT=3101
